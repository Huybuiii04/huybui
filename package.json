{
  "name": "ielts-writing-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/learning.test.ts tests/auth.test.ts tests/sync.test.ts tests/ai.test.ts",
    "test:edge": "node --test \"supabase/functions/_shared/tests/*.test.ts\"",
    "db:migrate": "node --env-file-if-exists=.env.local supabase/scripts/migrate.mjs",
    "db:verify": "node --env-file-if-exists=.env.local supabase/scripts/verify-schema.mjs && node --env-file-if-exists=.env.local supabase/scripts/verify-rls.mjs",
    "db:seed": "node --env-file-if-exists=.env.local supabase/seed/seed-content.ts && node --env-file-if-exists=.env.local supabase/seed/seed-prompts.mjs && node --env-file-if-exists=.env.local supabase/seed/seed-library.mjs && node --env-file-if-exists=.env.local supabase/seed/seed-ai-pricing.mjs",
    "db:seed:prompts": "node --env-file-if-exists=.env.local supabase/seed/seed-prompts.mjs",
    "db:seed:content": "node --env-file-if-exists=.env.local supabase/seed/seed-content.ts",
    "db:seed:library": "node --env-file-if-exists=.env.local supabase/seed/seed-library.mjs",
    "db:seed:pricing": "node --env-file-if-exists=.env.local supabase/seed/seed-ai-pricing.mjs",
    "db:prune": "node --env-file-if-exists=.env.local supabase/scripts/prune-duplicate-prompts.mjs",
    "db:cron": "node --env-file-if-exists=.env.local supabase/scripts/setup-cron.mjs",
    "db:deploy": "node --env-file-if-exists=.env.local supabase/scripts/deploy-functions.mjs",
    "deploy:vercel": "node --env-file-if-exists=.env.local supabase/scripts/vercel-env.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.0",
    "@fontsource/work-sans": "^5.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "i18next": "^25.6.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
