{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "middleware.ts": {
      "includeFiles": "src/agent/**"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "huybui.vercel.app" }],
      "destination": "https://engloo.app/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "huybui.vercel.app" }],
      "destination": "https://engloo.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/((?!api/|assets/|fonts/|images/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
